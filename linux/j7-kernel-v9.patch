diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index cb68adcab..0d6e0a548 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -81,9 +81,29 @@
 	 *  x20        primary_entry() .. __primary_switch()    CPU boot mode
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
+/* J7 debug: paint a 40x80 block at column \col into the framebuffer (MMU off, phys addr) */
+	.macro	j7_fbmark_asm, col, hi, lo
+	movz	x9, #0x6700, lsl #16
+	add	x9, x9, #((\col) * 160)
+	movz	w10, #(\hi), lsl #16
+	movk	w10, #(\lo)
+	mov	x11, #80
+.Lj7r\@:
+	mov	x12, #40
+	mov	x13, x9
+.Lj7c\@:
+	str	w10, [x13], #4
+	subs	x12, x12, #1
+	b.ne	.Lj7c\@
+	add	x9, x9, #2880
+	subs	x11, x11, #1
+	b.ne	.Lj7r\@
+	.endm
+
 SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
 	bl	preserve_boot_args
+	j7_fbmark_asm 0, 0xFFFF, 0x0000
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -91,6 +111,7 @@ SYM_CODE_START(primary_entry)
 	adrp	x0, init_idmap_pg_dir
 	mov	x1, xzr
 	bl	__pi_create_init_idmap
+	j7_fbmark_asm 1, 0xFFFF, 0xFF00
 
 	/*
 	 * If the page tables have been populated with non-cacheable
@@ -118,6 +139,7 @@ SYM_CODE_START(primary_entry)
 1:	mov	x0, x19
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
+	j7_fbmark_asm 2, 0xFF00, 0xFF00
 
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
@@ -519,6 +541,7 @@ SYM_FUNC_START_LOCAL(__no_granule_support)
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
+	j7_fbmark_asm 3, 0xFF00, 0xFFFF
 	adrp	x1, reserved_pg_dir
 	adrp	x2, init_idmap_pg_dir
 	bl	__enable_mmu
diff --git a/arch/arm64/kernel/j7fbcon.c b/arch/arm64/kernel/j7fbcon.c
new file mode 100644
index 000000000..2adfa246e
--- /dev/null
+++ b/arch/arm64/kernel/j7fbcon.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy J7 (Exynos 7580) bring-up: tiny printk console that draws text straight into the
+ * UEFI/S-Boot framebuffer (phys 0x67000000, 720x1280, 32 bpp) so kernel logs (initcall_debug!)
+ * are visible without a serial port or a working fb driver.
+ *
+ * It is a boot console: it is removed automatically once a real console (tty0/fbcon) takes
+ * over, unless "keep_bootcon" is on the command line.  The top 96 px stay free for the
+ * j7fbmark progress blocks.  Output wraps around from the bottom to the first text row; the
+ * line after the cursor is cleared, so the newest line is always right above the cursor bar.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/string.h>
+#include "j7fbfont.h"
+
+#define J7_FB_PHYS	0x67000000UL
+#define J7_FB_W		720
+#define J7_FB_H		1280
+#define J7_FB_STRIDE	2880
+#define J7_CW		8
+#define J7_CH		16
+#define J7_COLS		(J7_FB_W / J7_CW)
+#define J7_ROWS		(J7_FB_H / J7_CH)
+#define J7_FIRST_ROW	6		/* 96 px kept for the progress blocks */
+
+static u8 __iomem *j7fb;
+static int j7_cx, j7_cy = J7_FIRST_ROW;
+
+static void j7_fill(int col, int row, int ncols, u32 color)
+{
+	int y, x;
+
+	for (y = 0; y < J7_CH; y++) {
+		u32 __iomem *p = (u32 __iomem *)(j7fb + (row * J7_CH + y) * J7_FB_STRIDE) + col * J7_CW;
+
+		for (x = 0; x < ncols * J7_CW; x++)
+			__raw_writel(color, p + x);
+	}
+}
+
+static void j7_glyph(int col, int row, unsigned char c)
+{
+	const unsigned char *g = &font8x16[c * 16];
+	int y, x;
+
+	for (y = 0; y < J7_CH; y++) {
+		u32 __iomem *p = (u32 __iomem *)(j7fb + (row * J7_CH + y) * J7_FB_STRIDE) + col * J7_CW;
+
+		for (x = 0; x < J7_CW; x++)
+			__raw_writel((g[y] & (0x80 >> x)) ? 0xFFFFFFFF : 0xFF000000, p + x);
+	}
+}
+
+static void j7_newline(void)
+{
+	j7_cx = 0;
+	if (++j7_cy >= J7_ROWS)
+		j7_cy = J7_FIRST_ROW;
+	j7_fill(0, j7_cy, J7_COLS, 0xFF000000);
+}
+
+static void j7fbcon_write(struct console *co, const char *s, unsigned int n)
+{
+	while (n--) {
+		unsigned char c = *s++;
+
+		if (c == '\n') {
+			j7_newline();
+		} else if (c == '\r') {
+			j7_cx = 0;
+		} else {
+			if (c == '\t')
+				c = ' ';
+			if (j7_cx >= J7_COLS)
+				j7_newline();
+			j7_glyph(j7_cx++, j7_cy, c);
+		}
+	}
+	/* cursor bar: red block after the last character */
+	if (j7_cx < J7_COLS)
+		j7_fill(j7_cx, j7_cy, 1, 0xFFFF0000);
+}
+
+static struct console j7fbcon = {
+	.name	= "j7fb",
+	.write	= j7fbcon_write,
+	.flags	= CON_PRINTBUFFER | CON_BOOT,
+	.index	= -1,
+};
+
+static int __init j7fbcon_init(void)
+{
+	j7fb = ioremap_wc(J7_FB_PHYS, J7_FB_STRIDE * J7_FB_H);
+	if (!j7fb) {
+		pr_warn("j7fbcon: cannot map framebuffer\n");
+		return -ENOMEM;
+	}
+	j7_fill(0, J7_FIRST_ROW, J7_COLS, 0xFF000000);
+	register_console(&j7fbcon);
+	return 0;
+}
+console_initcall(j7fbcon_init);

diff --git a/arch/arm64/kernel/j7fbmark.c b/arch/arm64/kernel/j7fbmark.c
new file mode 100644
index 000000000..e22695072
--- /dev/null
+++ b/arch/arm64/kernel/j7fbmark.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Debug breadcrumbs for the Galaxy J7 (Exynos 7580) bring-up: paints a 40x80 px block
+ * into the UEFI/S-Boot framebuffer (phys 0x67000000, 720 px wide, 32 bpp) so a hang can
+ * be located without a serial console. Block N is drawn at x = N * 40.
+ */
+#include <linux/init.h>
+#include <linux/types.h>
+#include <asm/early_ioremap.h>
+#include <asm/io.h>
+
+#define J7_FB_PHYS   0x67000000UL
+#define J7_FB_STRIDE 2880
+#define J7_FB_ROWS   80
+
+void __init j7_fbmark(int col, u32 color)
+{
+	u8 __iomem *fb = early_ioremap(J7_FB_PHYS, J7_FB_ROWS * J7_FB_STRIDE);
+	int r, c;
+
+	if (!fb)
+		return;
+	for (r = 0; r < J7_FB_ROWS; r++)
+		for (c = 0; c < 40; c++)
+			__raw_writel(color, fb + r * J7_FB_STRIDE + (col * 40 + c) * 4);
+	early_iounmap(fb, J7_FB_ROWS * J7_FB_STRIDE);
+}
